# Настройки по умолчанию подходят для локального ChatMock.
TRANSLATE_AI_BASE_URL=http://127.0.0.1:8000/v1
TRANSLATE_AI_MODEL=gpt-5.3-codex-spark
TRANSLATE_AI_KEYS=

# Необязательные настройки.
TRANSLATE_AI_TIMEOUT_SECONDS=300
TRANSLATE_AI_MAX_ATTEMPTS=0
TRANSLATE_AI_COOLDOWN_SECONDS=60
TRANSLATE_AI_MAX_OUTPUT_TOKENS=8192
TRANSLATE_AI_RESPONSE_MAX_ATTEMPTS=3
TRANSLATE_AI_RESPONSE_COOLDOWN_SECONDS=0

# Локали, файлы и параллельная обработка.
TRANSLATE_SOURCE_CULTURE=en-US
TRANSLATE_TARGET_CULTURE=ru-RU
TRANSLATE_CONCURRENCY=2
TRANSLATE_BATCH_SIZE=100
TRANSLATE_CHUNK_SIZE=4000
# По умолчанию: 0.5 для русского, 0.8 для остальных языков.
# TRANSLATE_LANGUAGE_RATIO=0.5
# TRANSLATE_SOURCE_ROOT=Resources/Locale/en-US
# TRANSLATE_TARGET_ROOT=Resources/Locale/ru-RU
# TRANSLATE_PROMPT=prompts/ru-RU.md
# TRANSLATE_GLOSSARY=glossary.md
# TRANSLATE_PASS_LIST=pass_list.yml
# TRANSLATE_LANGUAGE_PROFILE=language-profile.yml
TRANSLATE_PASS_IGNORE_FILES=false

# Окно задаётся вручную; название модели для расчёта не используется.
# По умолчанию оцениваем по числу UTF-8-байтов, берём тройной запас
# на расширение перевода и используем только 65% выходного окна.
TRANSLATE_AI_TOKENIZER=bytes
TRANSLATE_AI_OUTPUT_EXPANSION=3
TRANSLATE_AI_OUTPUT_SAFETY=0.65
TRANSLATE_AI_OUTPUT_RESERVE=128
# Если точно известна кодировка модели: cl100k_base или o200k_base вместо bytes.
# Ограничение входного окна необязательно, но включает подсказку и pass-лист.
TRANSLATE_AI_MAX_INPUT_TOKENS=0
TRANSLATE_AI_TOKEN_LIMIT_FIELD=max_tokens
