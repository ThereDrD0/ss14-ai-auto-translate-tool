# СПРАВОЧНИК ПО НАСТРОЙКАМ
#
# Скопируйте этот файл в .env рядом с run.py и редактируйте копию.
# Программа читает .env при запуске. Сам .env храните только у себя:
# в нём может быть секретный ключ доступа к сервису ИИ.
#
# Формат строки: НАЗВАНИЕ=значение. Строка с # в начале — пояснение;
# такая строка не меняет настройки. Комментарий после значения не пишите:
# программа примет его за часть значения. Настройки, уже заданные в системе,
# имеют приоритет над .env; параметры команды имеют приоритет над ними.
#
# При установке внутри игры для первого запуска обычно достаточно раздела 1.
# Если инструмент установлен отдельно, прочитайте также раздел 4.
# Строки без # уже действуют. Строки вида «# НАЗВАНИЕ=значение» — примеры
# необязательных настроек; пока перед ними стоит #, они не действуют.
# Числа с точкой записываются без запятой.

# 1. Подключение к сервису перевода
#
# Программа не содержит ИИ-модель: она обращается к локальному серверу
# или внешнему сервису через интерфейс OpenAI (формат обмена запросами).
# Эти примеры подходят для локального ChatMock; запуск описан в HOW_TO_SETUP.md.
# Адрес сервера. 127.0.0.1 означает «этот компьютер», 8000 — номер порта.
# Обычно адрес заканчивается на /v1; пути /models и /chat/completions
# программа добавит сама.
# Для внешнего сервиса замените адрес на выданный поставщиком.
TRANSLATE_AI_BASE_URL=http://127.0.0.1:8000/v1

# Название модели, которое знает сервер. Если такой модели на вашем сервере
# нет, замените название. В меню можно выбрать другую модель из списка
# сервера; выбор в меню важнее этого значения.
TRANSLATE_AI_MODEL=gpt-5.6-luna

# Секретный ключ для внешнего сервиса. Для сервера на этом компьютере можно
# оставить пустым: программа подставит служебное значение local.
# Несколько адресов, моделей или ключей можно перечислить через запятую.
TRANSLATE_AI_KEYS=

# Максимальная длина ОТВЕТА модели в токенах. Токен — единица объёма текста
# у сервиса ИИ; это не обязательно слово или символ. Значение отправляется
# серверу и используется при расчёте размера запросов. Укажите реальный
# предел ответа выбранной модели; если он равен 8192, поставьте 8192.
TRANSLATE_AI_MAX_OUTPUT_TOKENS=16384

# 2. Какие языки переводить
#
# Код исходного и целевого языка. В командах без меню эти значения задают
# направление перевода. В меню это лишь первоначальный выбор: можно выбрать
# другие языки, и программа будет работать именно с выбранными.
# en-US — английский (США), ru-RU — русский (Россия).
TRANSLATE_SOURCE_CULTURE=en-US
TRANSLATE_TARGET_CULTURE=ru-RU

# 3. Скорость и размер запросов
#
# Сколько запросов к серверу может выполняться одновременно. 2 — не более
# двух запросов. Увеличивайте только если сервис допускает такую нагрузку.
TRANSLATE_CONCURRENCY=2

# Дополнительный предел числа символов исходного текста в одном запросе.
# 0 означает «не задавать предел вручную»: программа всё равно делит текст
# по доступному окну модели; фиксированного предела числа ключей нет.
# Это число не ограничивает количество файлов.
TRANSLATE_CHUNK_SIZE=0

# 4. Если инструмент установлен отдельно от игры
#
# Обычно корень игры находится автоматически по папке Resources/Locale.
# Если инструмент находится вне репозитория игры, укажите полный путь к нему.
# Пример для Windows; на Linux путь может быть /home/user/sunrise-station.
# SS14_REPO_ROOT=C:/Games/sunrise-station

# 5. Повторы при ошибках сервера
#
# Сколько секунд ждать ответа на сетевой запрос. 300 — пять минут.
# TRANSLATE_AI_TIMEOUT_SECONDS=300

# Предел числа попыток при временном сетевом сбое или ответе сервера
# 429 (слишком много запросов) или 5xx (ошибка сервера).
# 0 — без ограничения числа повторов; 3 — не более трёх попыток.
# Ошибка ключа доступа не считается временной и так не повторяется.
# TRANSLATE_AI_MAX_ATTEMPTS=0

# Сколько секунд ждать перед новым запросом к серверу после временного сбоя.
# TRANSLATE_AI_COOLDOWN_SECONDS=60

# Отдельный предел повторов, если сервер ответил, но текст не прошёл проверку
# формата или языка. 3 — не более трёх ответов; 0 — без ограничения.
# TRANSLATE_AI_RESPONSE_MAX_ATTEMPTS=3

# Пауза в секундах между повторами ответа, не прошедшего проверку. 0 — без паузы.
# TRANSLATE_AI_RESPONSE_COOLDOWN_SECONDS=0

# 6. Проверка перевода и вспомогательные файлы
#
# Минимальная доля букв целевого языка в проверяемом переводе: число больше
# 0 и не больше 1. По умолчанию для любого языка 0.15 (15%). Оставьте
# строку выключенной, если этот порог подходит вам.
# TRANSLATE_LANGUAGE_RATIO=0.15

# YAML-файл (текстовый список) с названиями и терминами, которые нужно
# сохранить без перевода.
# По умолчанию используется <целевой язык>-PASS_LIST.yml из папки инструмента.
# Чтобы заменить этот набор, сначала создайте
# свой файл и укажите его путь здесь.
# TRANSLATE_PASS_LIST=custom-pass-list.yml

# Свой YAML-словарь для проверки языка перевода. Он заменяет встроенный
# определитель и нужен, если тот не поддерживает выбранный язык. В файле
# должны быть код языка (language) и список слов (words); см. ADVANCED_SETUP.md.
# TRANSLATE_LANGUAGE_PROFILE=language-profile.yml

# Инструкция для ИИ. Обычно выбирается файл prompts/<целевой язык>.md;
# если его нет, используется prompts/default.md. Если задать файл здесь,
# он будет применяться и после смены языка в меню.
# TRANSLATE_PROMPT=prompts/ru-RU.md

# Словарь переводов и терминов, который добавляется к инструкции для ИИ.
# По умолчанию используется <целевой язык>-GLOSSARY.md из папки инструмента.
# TRANSLATE_GLOSSARY=ru-RU-GLOSSARY.md

# Пути, которые инструмент не изменяет. Разделяйте дополнительные пути знаком ;.
# По умолчанию защищена Resources/Locale/en-US, кроме папок проектов,
# начинающихся с _. _prototypes и _strings — служебные контейнеры:
# их обычные файлы защищены, а вложенные папки проектов доступны для перевода.
# TRANSLATE_PASS_PATHS=Resources/Locale/fr-FR/archive;Resources/Locale/de-DE/legacy.ftl

# Пути к файлам выше можно писать относительно папки инструмента или
# указывать полным путём. Файлы должны существовать до запуска.

# 7. Расчёт размера запроса — проверьте пределы при смене модели
#
# Способ оценки токенов. bytes считает байты текста в кодировке UTF-8
# с запасом. Это работает без знания внутреннего устройства модели. Если вы точно
# знаете кодировку модели, можно указать cl100k_base или o200k_base.
# TRANSLATE_AI_TOKENIZER=bytes

# Во сколько раз возможный ответ может быть длиннее исходного текста.
# 3 — программа закладывает тройной запас на расширение при переводе.
# TRANSLATE_AI_OUTPUT_EXPANSION=3

# Доля окна ответа, которую разрешено занять расчётному переводу.
# 0.65 — 65%; остальное оставлено как запас на ошибку оценки.
# TRANSLATE_AI_OUTPUT_SAFETY=0.65

# Дополнительный запас токенов при расчёте размера ответа и входного текста.
# TRANSLATE_AI_OUTPUT_RESERVE=128

# Максимум токенов входного текста: инструкция, исходник и примеры перевода.
# 922000 — консервативный предел для модели с большим общим окном.
# Для другой модели вычтите место для ответа из её общего окна.
# Значение 0 отключает проверку входного окна; используйте его, только
# если размер запроса контролируется другим способом.
# TRANSLATE_AI_MAX_INPUT_TOKENS=922000

# Название поля лимита ответа в запросе к серверу. По умолчанию программа
# выбирает его сама: max_completion_tokens для gpt-5.6-luna, max_tokens для
# остальных моделей. Задайте строку только если ваш сервер требует иного.
# TRANSLATE_AI_TOKEN_LIMIT_FIELD=max_tokens
